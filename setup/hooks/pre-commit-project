#!/usr/bin/env bash
# Stops a source commit when the brain has not been committed to since the project's last commit.
# Deliberately weak: it compares commit times only, so a pass is not proof the brain is current.
# Bypass: git commit --no-verify

# Edit for your project's layout: paths whose changes should usually teach the brain something.
SOURCE_PATTERN='^(src|app|lib|database|config|tests)/'

REPO_DIR="$(git rev-parse --show-toplevel)"
BRAIN_DIR="$REPO_DIR/../__BRAIN_NAME__"

changed_source=$(git -C "$REPO_DIR" diff --cached --name-only | grep -E "$SOURCE_PATTERN")
[ -z "$changed_source" ] && exit 0
[ -d "$BRAIN_DIR/.git" ] || exit 0

project_last=$(git -C "$REPO_DIR" log -1 --format=%ct 2>/dev/null || echo 0)
brain_last=$(git -C "$BRAIN_DIR" log -1 --format=%ct 2>/dev/null || echo 0)
[ "$brain_last" -ge "$project_last" ] && exit 0

echo ""
echo "Brain check: this commit touches source files, but __BRAIN_NAME__ has not been committed to"
echo "since this project's last commit:"
echo ""
echo "$changed_source" | sed 's/^/  /'
echo ""
echo "If this change taught you something, made a decision, fixed a documented bug or changed a"
echo "verified fact, update the brain file and commit it there, then retry."
echo "If it genuinely needs no documenting: git commit --no-verify"
echo ""
exit 1
